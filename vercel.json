{
  "cleanUrls": true,
  "functions": { "api/heir.js": { "maxDuration": 60 } },
  "crons": [{ "path": "/api/heir?action=sweep", "schedule": "7 12 * * *" }],
  "headers": [{ "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }, { "key": "X-Frame-Options", "value": "SAMEORIGIN" }] },
    { "source": "/assets/fonts/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }]
}
